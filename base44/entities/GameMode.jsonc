{
  "name": "GameMode",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "What this difficulty mode is and who it suits"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "normal",
        "hard"
      ]
    },
    "score_multiplier": {
      "type": "number"
    },
    "hull_plates": {
      "type": "number"
    },
    "tag": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "description"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}